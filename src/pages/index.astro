---
import { defaultLang } from "@/lib/i18n";
import "../styles/global.css";
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting</title>
    <meta http-equiv="refresh" content={`0; url=/${defaultLang}/`} />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          document.documentElement.removeAttribute("data-theme");
        }
      })();
    </script>
  </head>
  <body>
    <main class="redirect-page">
      <section class="redirect-card" aria-labelledby="redirect-title">
        <p class="redirect-eyebrow">Redirecting</p>
        <h1 id="redirect-title">Taking you to Hung Blog</h1>
        <p>
          Tiếng Việt là ngôn ngữ mặc định. Continue to
          <a href={`/${defaultLang}/`}>/{defaultLang}/</a>.
        </p>
      </section>
    </main>
  </body>
</html>
