---
import { getCollection } from "astro:content";
import Pagination from "@/components/Pagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  blogPath,
  languages,
  pageCount,
  paginate,
  postsBySeries,
  POSTS_PER_PAGE,
  type Lang,
  ui,
  uniqueSeries,
} from "@/lib/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return languages.flatMap((lang) =>
    uniqueSeries(posts, lang).map((series) => ({
      params: { lang, series: series.id },
      props: { lang, posts, series },
    })),
  );
}

const lang = Astro.props.lang as Lang;
const labels = ui[lang];
const series = Astro.props.series;
const allSeriesPosts = postsBySeries(Astro.props.posts, lang, series.id);
const totalPages = pageCount(allSeriesPosts, POSTS_PER_PAGE);
const posts = paginate(allSeriesPosts, 1, POSTS_PER_PAGE);
const basePath = `/${lang}/series/${series.id}/`;
---

<BaseLayout lang={lang} title={series.title}>
  <section class="hero">
    <p class="eyebrow">{labels.postsInSeries}</p>
    <h1>{series.title}</h1>
  </section>

  <section class="series-detail" aria-label={series.title}>
    <ol class="series-detail-list">
      {
        posts.map((post) => (
          <li class="series-detail-item">
            <a href={blogPath(post)}>
              <span class="series-detail-part">
                {labels.part} {post.data.series?.order}
              </span>
              <span class="series-detail-title">{post.data.title}</span>
              <span class="series-detail-description">{post.data.description}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <Pagination
    currentPage={1}
    totalPages={totalPages}
    basePath={basePath}
    lang={lang}
  />
</BaseLayout>
