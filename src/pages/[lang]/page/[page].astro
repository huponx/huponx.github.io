---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  languages,
  pageCount,
  paginate,
  postsByLang,
  POSTS_PER_PAGE,
  sortPosts,
  type Lang,
  ui,
} from "@/lib/i18n";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  return languages.flatMap((lang) => {
    const posts = sortPosts(postsByLang(allPosts, lang));
    const totalPages = pageCount(posts, POSTS_PER_PAGE);

    return Array.from({ length: totalPages - 1 }, (_, index) => {
      const currentPage = index + 2;
      return {
        params: { lang, page: String(currentPage) },
        props: { currentPage, lang, posts, totalPages },
      };
    });
  });
}

const lang = Astro.props.lang as Lang;
const labels = ui[lang];
const currentPage = Astro.props.currentPage as number;
const totalPages = Astro.props.totalPages as number;
const posts = paginate(Astro.props.posts, currentPage, POSTS_PER_PAGE);
const basePath = `/${lang}/`;
---

<BaseLayout lang={lang}>
  <section class="hero">
    <h1>{labels.siteTitle}</h1>
    <p>{labels.siteDescription}</p>
  </section>

  <section aria-labelledby="latest-posts">
    <h2 id="latest-posts">{labels.latestPosts}</h2>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      basePath={basePath}
      lang={lang}
    />
  </section>
</BaseLayout>
