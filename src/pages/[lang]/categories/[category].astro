---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categoryLabels,
  languages,
  pageCount,
  paginate,
  postsByCategory,
  POSTS_PER_PAGE,
  sortPosts,
  type Category,
  type Lang,
  ui,
  uniqueCategories,
} from "@/lib/i18n";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return languages.flatMap((lang) =>
    uniqueCategories(posts, lang).map((category) => ({
      params: { lang, category },
      props: { category, lang, posts },
    })),
  );
}

const lang = Astro.props.lang as Lang;
const category = Astro.props.category as Category;
const labels = ui[lang];
const allCategoryPosts = sortPosts(
  postsByCategory(Astro.props.posts, lang, category),
);
const totalPages = pageCount(allCategoryPosts, POSTS_PER_PAGE);
const posts = paginate(allCategoryPosts, 1, POSTS_PER_PAGE);
const basePath = `/${lang}/categories/${category}/`;
---

<BaseLayout lang={lang} title={categoryLabels[lang][category]}>
  <section class="hero">
    <p class="eyebrow">{labels.postsInCategory}</p>
    <h1>{categoryLabels[lang][category]}</h1>
  </section>

  <section class="post-grid" aria-label={categoryLabels[lang][category]}>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
  <Pagination
    currentPage={1}
    totalPages={totalPages}
    basePath={basePath}
    lang={lang}
  />
</BaseLayout>
