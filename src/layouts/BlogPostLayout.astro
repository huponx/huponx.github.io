---
import type { MarkdownHeading } from "astro";
import PostNavigation from "@/components/PostNavigation.astro";
import SeriesBlock from "@/components/SeriesBlock.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  blogPath,
  categoryLabels,
  categoryPath,
  findTranslation,
  languageNames,
  tagPath,
  type BlogPost,
  ui,
} from "@/lib/i18n";

interface Props {
  post: BlogPost;
  posts: BlogPost[];
  headings?: MarkdownHeading[];
}

const { post, posts, headings = [] } = Astro.props;
const lang = post.data.lang;
const labels = ui[lang];
const translation = findTranslation(post, posts);
const hasToc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3).length >= 2;
const languageSwitchHref = translation ? blogPath(translation) : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  wide
  languageSwitchHref={languageSwitchHref}
>
  <div class="post-layout">
    <article
      class="post"
      data-code-copy-label={labels.copyCode}
      data-code-copied-label={labels.copiedCode}
      data-code-copy-failed-label={labels.copyCodeFailed}
    >
      <a class="back-link" href={`/${lang}/`}>{labels.backToPosts}</a>

      <header class="post-header">
        <p class="eyebrow">
          <a href={categoryPath(lang, post.data.category)}>
            {categoryLabels[lang][post.data.category]}
          </a>
        </p>
        <h1>{post.data.title}</h1>
        <p class="description">{post.data.description}</p>
        <div class="post-header-meta">
          <div class="post-meta">
            <span>{labels.publishedOn} {post.data.pubDate.toLocaleDateString(lang)}</span>
          </div>
          <div class="language-switcher" aria-label="Language switcher">
            {
              translation ? (
                <a href={blogPath(translation)}>
                  {labels.availableIn}: {languageNames[translation.data.lang]}
                </a>
              ) : (
                <span class="disabled">{labels.unavailable}</span>
              )
            }
          </div>
        </div>
      </header>

      {hasToc && <TableOfContents headings={headings} lang={lang} variant="mobile" />}

      <div class="content">
        <slot />
      </div>

      <SeriesBlock post={post} posts={posts} />

      <footer class="tag-list" aria-label="Post tags">
        {
          post.data.tags.map((tag) => (
            <a href={tagPath(lang, tag)}>#{tag}</a>
          ))
        }
      </footer>

      <PostNavigation post={post} posts={posts} />
    </article>

    {
      hasToc && (
        <aside class="post-toc-sidebar">
          <TableOfContents headings={headings} lang={lang} variant="desktop" />
        </aside>
      )
    }
  </div>

  <button
    class="go-to-top"
    type="button"
    data-go-to-top
    hidden
    aria-label={labels.goToTop}
    title={labels.goToTop}
  >
    <span class="sr-only">{labels.goToTop}</span>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </button>

  <script is:inline>
    const GO_TO_TOP_THRESHOLD = 480;
    const GO_TO_TOP_MIN_SCROLL = 400;
    let tocSpyObserver = null;
    let tocSpyAbort = null;

    function initCodeBlocks() {
      const root = document.querySelector(".post");
      if (!(root instanceof HTMLElement)) return;

      const copyLabel = root.getAttribute("data-code-copy-label") ?? "Copy";
      const copiedLabel = root.getAttribute("data-code-copied-label") ?? "Copied";
      const failedLabel = root.getAttribute("data-code-copy-failed-label") ?? "Copy failed";

      document.querySelectorAll(".content pre.astro-code").forEach((pre) => {
        if (!(pre instanceof HTMLElement) || pre.dataset.codeBlockReady === "true") {
          return;
        }

        const parent = pre.parentElement;
        if (!parent) return;

        pre.dataset.codeBlockReady = "true";

        const wrapper = document.createElement("div");
        wrapper.className = "code-block";

        const header = document.createElement("div");
        header.className = "code-block-header";

        const title = pre.getAttribute("data-title") ?? pre.getAttribute("data-language") ?? "";
        const titleEl = document.createElement("span");
        titleEl.className = "code-block-title";
        titleEl.textContent = title;

        const button = document.createElement("button");
        button.className = "code-copy-button";
        button.type = "button";
        button.textContent = copyLabel;
        button.setAttribute("aria-label", copyLabel);

        button.addEventListener("click", async () => {
          const code = pre.querySelector("code")?.textContent ?? "";

          try {
            await navigator.clipboard.writeText(code);
            button.textContent = copiedLabel;
            button.setAttribute("aria-label", copiedLabel);
          } catch {
            button.textContent = failedLabel;
            button.setAttribute("aria-label", failedLabel);
          } finally {
            window.setTimeout(() => {
              button.textContent = copyLabel;
              button.setAttribute("aria-label", copyLabel);
            }, 1600);
          }
        });

        header.append(titleEl, button);
        parent.insertBefore(wrapper, pre);
        wrapper.append(header, pre);
      });
    }

    function initGoToTop() {
      const button = document.querySelector("[data-go-to-top]");
      if (!(button instanceof HTMLButtonElement)) return;

      let ticking = false;

      function updateVisibility() {
        const scrollY = window.scrollY;
        const viewportHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const distanceFromBottom = documentHeight - (scrollY + viewportHeight);
        const pageIsScrollable = documentHeight > viewportHeight + GO_TO_TOP_MIN_SCROLL;
        const nearBottom = distanceFromBottom <= GO_TO_TOP_THRESHOLD;

        if (pageIsScrollable && nearBottom) {
          button.hidden = false;
          button.classList.add("is-visible");
        } else {
          button.classList.remove("is-visible");
          button.hidden = true;
        }
      }

      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateVisibility();
          ticking = false;
        });
      }

      if (button.dataset.goToTopReady === "true") {
        updateVisibility();
        return;
      }
      button.dataset.goToTopReady = "true";

      button.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      updateVisibility();
    }

    function initTocScrollSpy() {
      if (tocSpyObserver) {
        tocSpyObserver.disconnect();
        tocSpyObserver = null;
      }
      if (tocSpyAbort) {
        tocSpyAbort.abort();
        tocSpyAbort = null;
      }

      const tocRoot = document.querySelector(".post-toc-sidebar .toc-desktop");
      if (!tocRoot) return;

      const content = document.querySelector(".post .content");
      if (!content) return;

      const articleHeadings = [...content.querySelectorAll("h2, h3")].filter(
        (element) => element.id,
      );
      if (articleHeadings.length === 0) return;

      tocSpyAbort = new AbortController();
      const { signal } = tocSpyAbort;
      let lastActiveSectionSlug = null;

      let lastH2Id = "";
      const headingMeta = articleHeadings.map((element) => {
        if (element.tagName === "H2") {
          lastH2Id = element.id;
          return { element, slug: element.id, sectionSlug: element.id };
        }
        return { element, slug: element.id, sectionSlug: lastH2Id };
      });

      function getSectionDetails(sectionSlug) {
        const section = tocRoot.querySelector(
          `[data-toc-section="${CSS.escape(sectionSlug)}"]`,
        );
        return section instanceof HTMLDetailsElement ? section : null;
      }

      function collapseScrollOnlySection(details) {
        if (!(details instanceof HTMLDetailsElement)) return;
        if (details.dataset.tocUserOpen === "true") return;
        details.open = false;
        delete details.dataset.tocScrollOpen;
      }

      tocRoot.querySelectorAll(".toc-section-details").forEach((details) => {
        if (!(details instanceof HTMLDetailsElement)) return;

        const summary = details.querySelector(".toc-section-summary");
        summary?.addEventListener(
          "pointerdown",
          (event) => {
            if (event.target instanceof Element && event.target.closest("[data-toc-link]")) {
              return;
            }
            details.dataset.tocUserIntent = "true";
          },
          { signal },
        );

        details.addEventListener(
          "toggle",
          () => {
            if (details.dataset.tocUserIntent !== "true") return;
            delete details.dataset.tocUserIntent;

            if (details.open) {
              details.dataset.tocUserOpen = "true";
              delete details.dataset.tocScrollOpen;
            } else {
              delete details.dataset.tocUserOpen;
              delete details.dataset.tocScrollOpen;
            }
          },
          { signal },
        );
      });

      function applyActive(activeSlug, sectionSlug) {
        if (lastActiveSectionSlug && lastActiveSectionSlug !== sectionSlug) {
          collapseScrollOnlySection(getSectionDetails(lastActiveSectionSlug));
        }
        lastActiveSectionSlug = sectionSlug;

        tocRoot.querySelectorAll("[data-toc-section]").forEach((section) => {
          const isActiveSection =
            section.getAttribute("data-toc-section") === sectionSlug;

          section.classList.toggle("is-active-section", isActiveSection);

          if (!(section instanceof HTMLDetailsElement)) return;

          if (isActiveSection) {
            section.open = true;
            if (section.dataset.tocUserOpen !== "true") {
              section.dataset.tocScrollOpen = "true";
            }
          } else if (section.dataset.tocScrollOpen === "true") {
            collapseScrollOnlySection(section);
          }
        });

        tocRoot.querySelectorAll("[data-toc-link]").forEach((link) => {
          const isActive = link.getAttribute("href") === `#${activeSlug}`;
          link.classList.toggle("is-active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "location");
            const reducedMotion = window.matchMedia(
              "(prefers-reduced-motion: reduce)",
            ).matches;
            link.scrollIntoView({
              block: "nearest",
              behavior: reducedMotion ? "auto" : "instant",
            });
          } else {
            link.removeAttribute("aria-current");
          }
        });
      }

      const visible = new Set();

      function updateActiveFromVisible() {
        let active = headingMeta[0];

        for (const meta of headingMeta) {
          if (visible.has(meta.slug)) {
            active = meta;
          }
        }

        if (visible.size === 0) {
          const offset = window.innerHeight * 0.15;
          for (const meta of headingMeta) {
            if (meta.element.getBoundingClientRect().top <= offset) {
              active = meta;
            }
          }
        }

        applyActive(active.slug, active.sectionSlug);
      }

      tocSpyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            if (!id) return;
            if (entry.isIntersecting) {
              visible.add(id);
            } else {
              visible.delete(id);
            }
          });
          updateActiveFromVisible();
        },
        { root: null, rootMargin: "-10% 0px -55% 0px", threshold: 0 },
      );

      headingMeta.forEach((meta) => tocSpyObserver.observe(meta.element));

      tocRoot.querySelectorAll("[data-toc-link]").forEach((link) => {
        link.addEventListener("click", (event) => event.stopPropagation(), { signal });
      });

      const hash = location.hash.slice(1);
      if (hash) {
        const meta = headingMeta.find((entry) => entry.slug === hash);
        if (meta) {
          applyActive(meta.slug, meta.sectionSlug);
        }
      } else {
        updateActiveFromVisible();
      }
    }

    initCodeBlocks();
    initGoToTop();
    initTocScrollSpy();
    document.addEventListener("astro:page-load", () => {
      initCodeBlocks();
      initGoToTop();
      initTocScrollSpy();
    });
  </script>
</BaseLayout>
